# Frontend (public by design: protected by Row Level Security, safe in the browser)
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional: override the GitHub Pages base path (default /littlechicknest/)
# VITE_BASE_PATH=/

# Optional: Cloudflare Turnstile site key (public). Only set it when CAPTCHA is also switched on in Supabase Auth.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# NEVER put secret keys here. Gelato + Stripe secrets live only in Supabase (see the admin repo README).
